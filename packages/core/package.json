{
  "name": "react-native-cavynext",
  "version": "0.1.0",
  "description": "A cross-platform integration test framework for React Native, written in TypeScript.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "keywords": [
    "react",
    "react native",
    "ios",
    "android",
    "integration tests",
    "testing",
    "e2e",
    "specs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvanlaerhoven/react-native-cavynext.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tvanlaerhoven/react-native-cavynext#readme",
  "bugs": {
    "url": "https://github.com/tvanlaerhoven/react-native-cavynext/issues"
  },
  "author": "Tim Van Laerhoven",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.59.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "hoist-non-react-statics": "^3.3.2"
  },
  "devDependencies": {
    "@types/hoist-non-react-statics": "^3.3.5",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.11",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
